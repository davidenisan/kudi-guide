# Phase 0 — Telegram-only expense tracker
# Copy to .env in this folder (or set these in the repo-root .env).

NODE_ENV=development

# Telegram — token issued by @BotFather
TELEGRAM_BOT_TOKEN=

# MongoDB — Phase 0 database (separate from the Postgres/DATABASE_URL used by apps/api)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=kudi_guide_phase0

# Timezone used for "this month" summary boundaries
SUMMARY_TIMEZONE=Africa/Lagos

# Local NLU (understanding only — never generates user-facing text)
NLU_ENABLED=true
NLU_MODEL_URI=hf:Qwen/Qwen2.5-1.5B-Instruct-GGUF/qwen2.5-1.5b-instruct-q4_k_m.gguf
NLU_TIMEOUT_MS=15000

# true while developing (skip replayed test traffic), false with real testers
TELEGRAM_DROP_PENDING_UPDATES=true
