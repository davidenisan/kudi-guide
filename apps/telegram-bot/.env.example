# Phase 0 — Telegram-only expense tracker
# Copy to .env in this folder (or set these in the repo-root .env).

NODE_ENV=development

# Telegram — token issued by @BotFather
TELEGRAM_BOT_TOKEN=

# MongoDB — Phase 0 database (separate from the Postgres/DATABASE_URL used by apps/api)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=kudi_guide_phase0

# Timezone used for "this month" summary boundaries
SUMMARY_TIMEZONE=Africa/Lagos

# Local NLU. Reads what people mean, and writes the replies that carry no
# figures. Anything with an amount, merchant or total in it is still rendered
# from a template and filled in from the database.
NLU_ENABLED=true
# 3B is the smallest that holds a conversation. 1.5B classifies acceptably but
# parrots messages back when asked to reply, so it is only worth running with
# NLU replies falling through to templates.
NLU_MODEL_URI=hf:Qwen/Qwen2.5-3B-Instruct-GGUF/qwen2.5-3b-instruct-q4_k_m.gguf
NLU_TIMEOUT_MS=30000

# Private channel that failed receipts are reported to (optional).
# Create a channel, add the bot as admin, put its numeric ID here (starts with -100).
ADMIN_CHAT_ID=

# true while developing (skip replayed test traffic), false with real testers
TELEGRAM_DROP_PENDING_UPDATES=true
