{
  "name": "telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "tsx src/scripts/init-db.ts",
    "db:stats": "tsx src/scripts/db-stats.ts",
    "db:smoke": "tsx src/scripts/smoke.ts",
    "test:intent": "tsx src/scripts/test-intent.ts",
    "test:router": "tsx src/scripts/test-router.ts",
    "model:fetch": "tsx src/scripts/fetch-model.ts",
    "test:nlu": "tsx src/scripts/test-nlu.ts",
    "test:chat": "tsx src/scripts/test-chat.ts",
    "test:latency": "tsx src/scripts/test-latency.ts",
    "test:admin": "tsx src/scripts/test-admin-report.ts",
    "channel:id": "tsx src/scripts/find-chat-id.ts",
    "test:extract": "tsx src/scripts/test-extract.ts",
    "ocr": "./ocr/run.sh"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "grammy": "^1.45.1",
    "mongodb": "^6.12.0",
    "node-llama-cpp": "^3.20.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
