# API
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed by the API.
API_CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
PHONE_SIGNIN_ENABLED=false
TERMII_API_KEY=
TERMII_SENDER_ID=KudiGuide
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kudi_guide

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_BUCKET=kudi-guide
S3_FORCE_PATH_STYLE=true

# Web
# Set to the public HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://app.example.com
# For LAN testing, add explicit extra origins in apps/web/.env.local:
# APP_ALLOWED_ORIGINS=http://localhost:3000,http://172.20.10.3:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Local language and receipt recognition (no cloud API key)
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_MS=90000
TESSERACT_BIN=tesseract
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
